# Generated by `kedro docker init --with-spark`. kedro-docker never overwrites this
# file, so you can edit it. To generate a new one, delete it and run
# `kedro docker init --with-spark`.
#
# Build arguments (`docker build --build-arg NAME=value`):
#   BASE_IMAGE            Python image used by every stage
#   UV_VERSION            version of uv used to install the dependencies, latest if empty
#   KEDRO_UID, KEDRO_GID  user and group ID of the kedro_docker user
#   KEDRO_PIPELINES       comma-separated pipelines run by the default command
#                         (needs Kedro 1.2+), the default pipeline if empty
ARG BASE_IMAGE=python:3.12-slim

# Keep only the files that declare dependencies, so that the dependencies are
# installed again only when one of these files changes.
FROM ${BASE_IMAGE} AS dependency-files
COPY . /tmp/context
RUN mkdir /tmp/dependency-files && \
    for f in pyproject.toml uv.lock uv.toml requirements.txt; do \
        if [ -f "/tmp/context/$f" ]; then cp "/tmp/context/$f" /tmp/dependency-files/; fi; \
    done

# Install the dependencies into a virtual environment: from uv.lock if the project
# has one, otherwise requirements.txt, otherwise pyproject.toml. The project itself
# is not installed, because `kedro run` imports it from src/.
FROM ${BASE_IMAGE} AS builder
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    UV_NO_CACHE=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv
ARG UV_VERSION=""
RUN python3 -m pip install --no-cache-dir "uv${UV_VERSION:+==${UV_VERSION}}"
WORKDIR /tmp/dependency-files
COPY --from=dependency-files /tmp/dependency-files/ ./
# pip is added to the virtual environment, so that `pip install` in a container
# installs into it.
RUN uv venv --seed --python "$(command -v python3)" /opt/venv && \
    if [ -f uv.lock ]; then \
        uv sync --python /opt/venv/bin/python --frozen --no-default-groups --no-install-project; \
    elif [ -f requirements.txt ]; then \
        uv pip install --python /opt/venv/bin/python -r requirements.txt; \
    else \
        uv pip install --python /opt/venv/bin/python -r pyproject.toml; \
    fi
# Add local Spark support (PySpark and the HDFS and S3 filesystems) for the
# kedro-datasets version installed above. Other packages can change if these extras need it.
RUN DATASETS_VERSION="$(uv pip show --python /opt/venv/bin/python kedro-datasets 2>/dev/null | sed -n 's/^Version: //p')" && \
    uv pip install --python /opt/venv/bin/python \
        "kedro-datasets[spark-local,hdfs-base,s3fs-base]${DATASETS_VERSION:+==${DATASETS_VERSION}}"

FROM ${BASE_IMAGE} AS runtime

# install JVM
RUN apt-get update && mkdir -p /usr/share/man/man1 && \
    apt-get install -y --no-install-recommends procps default-jre-headless && \
    rm -rf /var/lib/apt/lists/*

# add kedro user
ARG KEDRO_UID=999
ARG KEDRO_GID=0
RUN groupadd -f -g ${KEDRO_GID} kedro_group && \
    useradd -m --no-log-init -d /home/kedro_docker -s /bin/bash -g ${KEDRO_GID} -u ${KEDRO_UID} kedro_docker

# copy only the virtual environment from the builder stage
COPY --from=builder --chown=${KEDRO_UID}:${KEDRO_GID} /opt/venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}"

WORKDIR /home/kedro_docker
USER kedro_docker

# copy the whole project except what is in .dockerignore
COPY --chown=${KEDRO_UID}:${KEDRO_GID} . .

# Declared last, so that images built for different pipelines share every other layer.
ARG KEDRO_PIPELINES=""
ENV KEDRO_PIPELINES="${KEDRO_PIPELINES}"

EXPOSE 8888

CMD ["sh", "-c", "exec kedro run ${KEDRO_PIPELINES:+--pipelines \"$KEDRO_PIPELINES\"}"]
